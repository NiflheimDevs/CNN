{
  "scopeName": "source.nngraph",
  "name": "NNGraph",
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#numbers"},
    {"include": "#keywords"},
    {"include": "#types"},
    {"match": "\\b[a-zA-Z_][a-zA-Z_0-9]*\\b", "name": "variable.other.nngraph"}
  ],
  "repository": {
    "comments": {"patterns": [{"match": "//.*$", "name": "comment.line.nngraph"}, {"begin": "/\\*", "end": "\\*/", "name": "comment.block.nngraph"}]},
    "strings": {"patterns": [{"begin": "\"", "end": "\"", "name": "string.quoted.double.nngraph", "patterns": [{"match": "\\\\.", "name": "constant.character.escape.nngraph"}]}]},
    "numbers": {"patterns": [{"match": "\\b-?[0-9]+\\.[0-9]+\\b", "name": "constant.numeric.float.nngraph"}, {"match": "\\b-?[0-9]+\\b", "name": "constant.numeric.integer.nngraph"}]},
    "keywords": {"patterns": [{"match": "\\b(model|input|output|tensor|graph|node|edge|config|label)\\b", "name": "keyword.control.nngraph"}]},
    "types": {"patterns": [{"match": "\\b(true|false|None)\\b", "name": "constant.language.nngraph"}, {"match": "\\b(Linear|Conv[0-9]+d|ReLU|Softmax|Flatten|Dropout|BatchNorm[0-9]+d|Add|Concat|Residual)\\b", "name": "support.type.nngraph"}]}
  }
}
